+/// PROBE PATCH: per-field heap report. `m` runs a closure that clones and leaks
+/// a value and returns the bytes it allocated.
+pub type MemFn<'a> = &'a dyn Fn(&mut dyn FnMut()) -> isize;
+impl ChangeGraph {
+    pub(crate) fn mem_report(&self, m: MemFn<'_>) -> Vec<(&'static str, usize, isize)> {
+        fn v<T>(x: &Vec<T>) -> isize { (x.capacity() * std::mem::size_of::<T>()) as isize }
+        let mut out = vec![
+            ("hashes: Vec<ChangeHash>", self.hashes.len(), v(&self.hashes)),
+            ("nodes_by_hash: HashMap<ChangeHash,NodeIdx>", self.nodes_by_hash.len(), m(&mut || std::mem::forget(self.nodes_by_hash.clone()))),
+            ("edges: Vec<Edge>", self.edges.len(), v(&self.edges)),
+            ("parents: Vec<Option<EdgeIdx>>", self.parents.len(), v(&self.parents)),
+            ("actors: Vec<ActorIdx>", self.actors.len(), v(&self.actors)),
+            ("seq: Vec<u32>", self.seq.len(), v(&self.seq)),
+            ("max_ops: Vec<u32>", self.max_ops.len(), v(&self.max_ops)),
+            ("seq_index: Vec<Vec<NodeIdx>>", self.seq_index.len(), v(&self.seq_index) + self.seq_index.iter().map(v).sum::<isize>()),
+            ("clock_cache: HashMap<NodeIdx,SeqClock>", self.clock_cache.len(), m(&mut || std::mem::forget(self.clock_cache.clone()))),
+            ("heads: BTreeSet<ChangeHash>", self.heads.len(), m(&mut || std::mem::forget(self.heads.clone()))),
+            ("fragments: Vec<FragmentNode>", self.fragments.len(), m(&mut || std::mem::forget(self.fragments.clone()))),
+            ("num_ops: hexane Column<u64>", 0, m(&mut || std::mem::forget(self.num_ops.clone()))),
+            ("timestamps: hexane DeltaColumn<i64>", 0, m(&mut || std::mem::forget(self.timestamps.clone()))),
+            ("messages: hexane Column<Option<String>>", 0, m(&mut || std::mem::forget(self.messages.clone()))),
+            ("extra_bytes_meta: hexane PrefixColumn", 0, m(&mut || std::mem::forget(self.extra_bytes_meta.clone()))),
+            ("extra_bytes_raw: Vec<u8>", self.extra_bytes_raw.len(), v(&self.extra_bytes_raw)),
+        ];
+        out.sort_by_key(|x| -x.2);
+        out
+    }
+}
