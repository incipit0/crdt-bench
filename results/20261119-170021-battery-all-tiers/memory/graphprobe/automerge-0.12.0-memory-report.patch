+            ("change_graph (clone)", m(&mut || std::mem::forget(self.change_graph.clone()))),
+            ("authors", m(&mut || std::mem::forget(self.authors.clone()))),
+            ("deps", m(&mut || std::mem::forget(self.deps.clone()))),
